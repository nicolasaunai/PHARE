# Copy to env.sh and fill in. Sourced by run.sh before every run, and by parts.sh.

# 1. The modules and the python environment both builds were made with, e.g.
# module purge
# module load ...
# source /path/to/venv/bin/activate

# 2. The two source trees and their build directories (the directory that holds pybindlibs/)
export PHARE_BRANCH_SRC=/path/to/PHARE-threads          # branch threads/patch-level
export PHARE_BRANCH_BUILD=$PHARE_BRANCH_SRC/build/rel
export PHARE_MASTER_SRC=/path/to/PHARE-master            # commit dc62fdd4e
export PHARE_MASTER_BUILD=$PHARE_MASTER_SRC/build/rel

# 3. Where logs, the result file and the (temporary) simulation output go: a scratch filesystem
export RESULTS=/path/on/scratch/phare-threads-genoa

# 4. Only if the default launch line of run.sh does not bind as README.md asks:
# export CORES=192
# launch() { srun --ntasks=$1 --cpus-per-task=$2 ... ; }    # $1 ranks, $2 threads, $3 full|spread
